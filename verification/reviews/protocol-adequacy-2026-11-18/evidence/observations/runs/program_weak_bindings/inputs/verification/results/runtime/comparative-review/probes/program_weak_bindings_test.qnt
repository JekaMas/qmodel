module bindings_test {
  import dvp(N=2,HOST=0,OPEN_REQUIRED=false,ESCROW=false,PRIVATE=false,MUTANT=0).* from "./program_weak_canonical"
  run signed=init.then(sign(1,0)).then(sign(1,1))
  run tradeBindingTest=signed.then(requestOpen(1,{...desc(1),trade:999}).fail())
  run nonceBindingTest=signed.then(requestOpen(1,{...desc(1),nonce:999}).fail())
  run chainABindingTest=signed.then(requestOpen(1,{...desc(1),chainA:999}).fail())
  run genesisABindingTest=signed.then(requestOpen(1,{...desc(1),genesisA:999}).fail())
  run chainBBindingTest=signed.then(requestOpen(1,{...desc(1),chainB:999}).fail())
  run genesisBBindingTest=signed.then(requestOpen(1,{...desc(1),genesisB:999}).fail())
  run decisionDomainBindingTest=signed.then(requestOpen(1,{...desc(1),decisionDomain:999}).fail())
  run assetABindingTest=signed.then(requestOpen(1,{...desc(1),assetA:999}).fail())
  run assetBBindingTest=signed.then(requestOpen(1,{...desc(1),assetB:999}).fail())
  run holdABindingTest=signed.then(requestOpen(1,{...desc(1),holdA:999}).fail())
  run holdBBindingTest=signed.then(requestOpen(1,{...desc(1),holdB:999}).fail())
  run decisionContractBindingTest=signed.then(requestOpen(1,{...desc(1),decisionContract:999}).fail())
  run securityBindingTest=signed.then(requestOpen(1,{...desc(1),security:999}).fail())
  run cashBindingTest=signed.then(requestOpen(1,{...desc(1),cash:999}).fail())
  run sellerABindingTest=signed.then(requestOpen(1,{...desc(1),sellerA:999}).fail())
  run buyerABindingTest=signed.then(requestOpen(1,{...desc(1),buyerA:999}).fail())
  run buyerBBindingTest=signed.then(requestOpen(1,{...desc(1),buyerB:999}).fail())
  run sellerBBindingTest=signed.then(requestOpen(1,{...desc(1),sellerB:999}).fail())
  run deadlineBindingTest=signed.then(requestOpen(1,{...desc(1),deadline:999}).fail())
  run protocolBindingTest=signed.then(requestOpen(1,{...desc(1),protocol:999}).fail())
  run epochBindingTest=signed.then(requestOpen(1,{...desc(1),epoch:999}).fail())
  run commitmentBindingTest=signed.then(requestOpen(1,{...desc(1),commitment:999}).fail())
}
