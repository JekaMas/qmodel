// Consumer-boundary certificate fixtures, not reachable native-source attacks.
// The independent adapter supplies valid certificates for other statement contexts.
// Their cryptographic membership is admitted separately from application policy;
// every case must reach commit with proof provenance already present. The actual
// source-derived unadmitted-program path is exercised separately below.
module proof_consumer_test {
 import dvp(N=2,HOST=0,OPEN_REQUIRED=false,ESCROW=false,PRIVATE=false,MUTANT=0).* from "../models/dvp"
 pure val CertifiedContexts=Set({...fact(1,2),d:{...desc(1),trade:2}},{...fact(1,2),d:{...desc(1),nonce:2}},{...fact(1,2),d:{...desc(1),chainA:99}},{...fact(1,2),d:{...desc(1),genesisA:99}},{...fact(1,2),d:{...desc(1),chainB:99}},{...fact(1,2),d:{...desc(1),genesisB:99}},{...fact(1,2),d:{...desc(1),decisionDomain:99}},{...fact(1,2),d:{...desc(1),assetA:99}},{...fact(1,2),d:{...desc(1),assetB:99}},{...fact(1,2),d:{...desc(1),holdA:99}},{...fact(1,2),d:{...desc(1),holdB:99}},{...fact(1,2),d:{...desc(1),decisionContract:99}},{...fact(1,2),d:{...desc(1),security:4}},{...fact(1,2),d:{...desc(1),cash:4}},{...fact(1,2),d:{...desc(1),sellerA:1}},{...fact(1,2),d:{...desc(1),buyerA:0}},{...fact(1,2),d:{...desc(1),buyerB:1}},{...fact(1,2),d:{...desc(1),sellerB:0}},{...fact(1,2),d:{...desc(1),deadline:99}},{...fact(1,2),d:{...desc(1),protocol:99}},{...fact(1,2),d:{...desc(1),epoch:99}},{...fact(1,2),d:{...desc(1),commitment:99}},{...fact(1,2),phase:1},{...fact(1,2),checkpoint:99},{...fact(1,2),program:0},{...fact(1,2),root:999},fact(1,2),{...fact(1,2),program:2})
 action certifiedArrival(f:Fact):bool=all {CertifiedContexts.contains(f),s.captured.contains(fact(1,2)),
  s'={...s,proofs:s.proofs.union(Set(f)),received:s.received.union(Set(f))}}
 run captured=init.then(sign(1,0)).then(sign(1,1)).then(openA(1)).then(prepareB(1)).then(finalize(1,2)).then(capture(1,2))
 run tradeConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),trade:2}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),trade:2}}) and s.received.contains({...fact(1,2),d:{...desc(1),trade:2}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run nonceConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),nonce:2}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),nonce:2}}) and s.received.contains({...fact(1,2),d:{...desc(1),nonce:2}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run chainAConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),chainA:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),chainA:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),chainA:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run genesisAConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),genesisA:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),genesisA:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),genesisA:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run chainBConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),chainB:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),chainB:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),chainB:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run genesisBConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),genesisB:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),genesisB:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),genesisB:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run decisionDomainConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),decisionDomain:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),decisionDomain:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),decisionDomain:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run assetAConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),assetA:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),assetA:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),assetA:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run assetBConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),assetB:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),assetB:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),assetB:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run holdAConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),holdA:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),holdA:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),holdA:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run holdBConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),holdB:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),holdB:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),holdB:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run decisionContractConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),decisionContract:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),decisionContract:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),decisionContract:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run securityConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),security:4}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),security:4}}) and s.received.contains({...fact(1,2),d:{...desc(1),security:4}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run cashConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),cash:4}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),cash:4}}) and s.received.contains({...fact(1,2),d:{...desc(1),cash:4}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run sellerAConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),sellerA:1}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),sellerA:1}}) and s.received.contains({...fact(1,2),d:{...desc(1),sellerA:1}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run buyerAConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),buyerA:0}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),buyerA:0}}) and s.received.contains({...fact(1,2),d:{...desc(1),buyerA:0}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run buyerBConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),buyerB:1}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),buyerB:1}}) and s.received.contains({...fact(1,2),d:{...desc(1),buyerB:1}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run sellerBConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),sellerB:0}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),sellerB:0}}) and s.received.contains({...fact(1,2),d:{...desc(1),sellerB:0}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run deadlineConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),deadline:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),deadline:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),deadline:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run protocolConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),protocol:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),protocol:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),protocol:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run epochConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),epoch:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),epoch:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),epoch:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run commitmentConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),d:{...desc(1),commitment:99}})).expect(s.proofs.contains({...fact(1,2),d:{...desc(1),commitment:99}}) and s.received.contains({...fact(1,2),d:{...desc(1),commitment:99}}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run phaseConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),phase:1})).expect(s.proofs.contains({...fact(1,2),phase:1}) and s.received.contains({...fact(1,2),phase:1}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run checkpointConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),checkpoint:99})).expect(s.proofs.contains({...fact(1,2),checkpoint:99}) and s.received.contains({...fact(1,2),checkpoint:99}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run programConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),program:0})).expect(s.proofs.contains({...fact(1,2),program:0}) and s.received.contains({...fact(1,2),program:0}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run rootConsumerRejectTest=captured.then(certifiedArrival({...fact(1,2),root:999})).expect(s.proofs.contains({...fact(1,2),root:999}) and s.received.contains({...fact(1,2),root:999}) and not(canCommit(s,1)) and safe and s.trades.get(1).effectsA==0).then(commit(1).fail())
 run matchingConsumerAcceptTest=captured.then(certifiedArrival(fact(1,2))).then(commit(1)).expect(safe and S10 and s.trades.get(1).effectsA==1)
 run actualUnadmittedProducerRejectTest=captured.then(proveUnadmitted(1,2)).then(deliverUnadmitted(1,2)).expect(s.proofs.contains({...fact(1,2),program:0}) and not(canCommit(s,1)) and safe).then(commit(1).fail())
 run unadmittedAfterRotationRejectTest=captured.then(proveUnadmitted(1,2)).then(rotate).then(deliverUnadmitted(1,2)).expect(not(canCommit(s,1)) and safe).then(commit(1).fail())
 run oldProgramAfterRotationExitTest=captured.then(prove(1,2)).then(rotate).then(exitMember).then(deliver(1,2)).then(commit(1)).expect(safe and S10 and s.trades.get(1).effectsA==1)
 run newlyAdmittedContextTest=captured.then(rotate).then(certifiedArrival({...fact(1,2),program:2})).then(commit(1)).expect(safe and S10 and s.trades.get(1).effectsA==1)
}
