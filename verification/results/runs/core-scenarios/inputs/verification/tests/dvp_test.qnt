module dvp_test {
  import dvp(N=1,HOST=0,OPEN_REQUIRED=false,ESCROW=false,PRIVATE=false,MUTANT=0).* from "../models/dvp"
  run signBoth = init.then(sign(1,0)).then(sign(1,1))
  run bothHolds = signBoth.then(openA(1)).then(prepareB(1))
  run cashProof = bothHolds.then(finalize(1,2)).then(capture(1,2)).then(prove(1,2)).then(deliver(1,2))
  run committed = cashProof.then(commit(1))
  run outcome = committed.then(finalize(1,3)).then(capture(1,3)).then(prove(1,3)).then(deliver(1,3)).then(learn(1,2,1))
  run settled = outcome.then(applyB(1))
  run abortProof = signBoth.then(tick).then(tick).then(abort(1)).then(finalize(1,4)).then(capture(1,4)).then(prove(1,4)).then(deliver(1,4))
  run successTest = settled.expect(safe and s.trades.get(1).effectsA==1 and s.trades.get(1).effectsB==1)
  run actualReservationTest = bothHolds.expect(reservedA(s)==2 and reservedB(s)==3 and s.ownerA==2 and s.ownerB==3)
  run bFirstTest = signBoth.then(prepareB(1)).then(openA(1)).expect(someHold and safe)
  run applicationLagTest = committed.expect(someLag and safe)
  run missingOpenTest = signBoth.then(prepareB(1)).then(tick).then(tick).then(abort(1)).expect(s.trades.get(1).decision==3 and safe)
  run abortBeforePrepareTest = abortProof.then(learn(1,3,1)).expect(s.trades.get(1).knownB==3 and safe).then(prepareB(1).fail())
  run lateUnknownAbortTest = abortProof.then(prepareB(1)).then(learn(1,3,1)).then(refund(1,1)).expect(s.trades.get(1).refundsB==1 and safe)
  run missingSecondHoldTest = signBoth.then(openA(1)).then(tick).then(tick).then(abort(1)).then(refund(1,0)).expect(safe and s.trades.get(1).refundsA==1)
  run lateProofTest = cashProof.then(tick).then(tick).then(abort(1)).expect(safe).then(commit(1).fail())
  run localRollbackTest = cashProof.then(freeze(0)).expect(s.trades.get(1).decision==1 and s.ownerA==2 and s.receivedA.get(1)==0).then(commit(1).fail())
  run abortRefundFailureTest = bothHolds.then(freeze(0)).then(tick).then(tick).then(abort(1)).expect(s.trades.get(1).decision==3 and s.trades.get(1).holdA==1).then(unfreeze(0)).then(refund(1,0)).expect(safe and s.trades.get(1).decision==3)
  run duplicateApplicationTest = settled.then(deliver(1,3)).then(learn(1,2,1)).expect(safe).then(applyB(1).fail())
  run deadlineBoundaryTest = cashProof.then(tick).then(commit(1)).expect(safe and someCommit)
  run retentionRotationTest = cashProof.then(rotate).then(exitMember).then(commit(1)).expect(safe)
  run witnessCapturePruningTest = bothHolds.then(finalize(1,2)).then(capture(1,2)).then(prune(1,2)).then(crash(3)).then(recover(3)).then(prove(1,2)).expect(s.proofs.contains(fact(1,2)))
  run projectionRecoveryTest = settled.then(crash(3)).then(recover(3)).expect(safe and s.trades.get(1).stale and s.trades.get(1).report==0)
  run transportSeparationTest = init.then(compromiseTransport).expect(S16)
  run unsignedTest = init.then(sign(1,0)).expect(safe).then(openA(1).fail())
  run spentCapacityTest = signBoth.then(spend(0)).expect(safe).then(openA(1).fail())
}
