// Staged beside the source-bound funded specialization by repeated_checks.py.
module repeated_test {
  import dvp(N=7,HOST=0,OPEN_REQUIRED=false,ESCROW=false,PRIVATE=false,MUTANT=0).* from "./dvp"
  import guarantee_oracles.* from "./guarantee_oracles"

  val sequenceSafe = safe and CDecision and Trades.forall(t=>tradeGuarantees(s,desc(t)))

  // The operational dispatcher includes the loss/prune edges omitted from the
  // normal and general adversarial entries. All actions originate in dvp.
  action operational = any {
    adversarialStep,
    nondet t=Trades.oneOf(); nondet p=0.to(6).oneOf(); any {lose(t,p),prune(t,p)}
  }

  def pending(t:int):bool = {
    val z=s.trades.get(t)
    z.decision==1 and z.holdA==1 and z.holdB==1 and z.effectsA==0 and z.effectsB==0
  }

  // Use independent literal quantities and per-trade recipient/account IDs.
  def committedTrade(t:int):bool = {
    val z=s.trades.get(t)
    and {
      z.decision==2,z.effectsA==1,z.effectsB==1,z.refundsA==0,z.refundsB==0,
      s.receivedA.get(t)==2,s.receivedB.get(t)==3,evidenceBackedBooking(s,desc(t)),
      s.economicReceipts.filter(r=>r.trade==t)==Set(
        {trade:t,leg:0,kind:0,chain:10,genesis:110,asset:30,account:t,quantity:2},
        {trade:t,leg:1,kind:0,chain:20,genesis:120,asset:40,account:t,quantity:3})
    }
  }

  def releasedTrade(t:int):bool = {
    val z=s.trades.get(t)
    and {
      z.decision==3,z.holdA==3,z.holdB==3,z.refundsA==1,z.refundsB==1,
      z.effectsA==0,z.effectsB==0,s.receivedA.get(t)==0,s.receivedB.get(t)==0,
      evidenceBackedBooking(s,desc(t)),
      s.economicReceipts.filter(r=>r.trade==t)==Set(
        {trade:t,leg:0,kind:1,chain:10,genesis:110,asset:30,account:0,quantity:2},
        {trade:t,leg:1,kind:1,chain:20,genesis:120,asset:40,account:0,quantity:3})
    }
  }

  pure val PARALLEL = Set(4,5,6)
  val durablePrefix = Set(1,2,3).forall(t=>s.financialRecords.contains({d:desc(t),outcome:if(t==2) 3 else 2}))
  val completed = Set(1,3,4,5,6).forall(t=>committedTrade(t)) and releasedTrade(2) and
    s.ownerA==0 and s.ownerB==0 and s.economicReceipts.size()==12 and s.financialRecords.size()==6
  run first = init.expect(sequenceSafe)
    .then(sign(1,0)).expect(sequenceSafe)
    .then(sign(1,1)).expect(sequenceSafe)
    .then(openA(1)).expect(sequenceSafe)
    .then(prepareB(1)).expect(sequenceSafe)
    .then(finalize(1,2)).expect(sequenceSafe)
    .then(capture(1,2)).expect(sequenceSafe)
    .then(prove(1,2)).expect(sequenceSafe)
    .then(deliver(1,2)).expect(sequenceSafe)
    .then(commit(1)).expect(sequenceSafe)
    .then(finalize(1,3)).expect(sequenceSafe)
    .then(capture(1,3)).expect(sequenceSafe)
    .then(prove(1,3)).expect(sequenceSafe)
    .then(deliver(1,3)).expect(sequenceSafe)
    .then(learn(1,2,1)).expect(sequenceSafe)
    .then(applyB(1)).expect(sequenceSafe)
    .then(finalize(1,5)).expect(sequenceSafe)
    .then(capture(1,5)).expect(sequenceSafe)
    .then(prove(1,5)).expect(sequenceSafe)
    .then(deliver(1,5)).expect(sequenceSafe)
    .then(observe(1,0)).expect(sequenceSafe)
    .then(finalize(1,6)).expect(sequenceSafe)
    .then(capture(1,6)).expect(sequenceSafe)
    .then(prove(1,6)).expect(sequenceSafe)
    .then(deliver(1,6)).expect(sequenceSafe)
    .then(observe(1,1)).expect(sequenceSafe)
    .then(reconcile(1)).expect(sequenceSafe)
  run released = first
    .then(sign(2,0)).expect(sequenceSafe)
    .then(sign(2,1)).expect(sequenceSafe)
    .then(openA(2)).expect(sequenceSafe)
    .then(prepareB(2)).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(abort(2)).expect(sequenceSafe)
    .then(finalize(2,4)).expect(sequenceSafe)
    .then(capture(2,4)).expect(sequenceSafe)
    .then(prove(2,4)).expect(sequenceSafe)
    .then(deliver(2,4)).expect(sequenceSafe)
    .then(learn(2,3,1)).expect(sequenceSafe)
    .then(refund(2,0)).expect(sequenceSafe)
    .then(refund(2,1)).expect(sequenceSafe)
    .then(captureAbortRecord(2,0)).expect(sequenceSafe)
    .then(captureAbortRecord(2,1)).expect(sequenceSafe)
    .then(recordAbort(2)).expect(sequenceSafe)
  run sequential = released
    .then(sign(3,0)).expect(sequenceSafe)
    .then(sign(3,1)).expect(sequenceSafe)
    .then(openA(3)).expect(sequenceSafe)
    .then(prepareB(3)).expect(sequenceSafe)
    .then(finalize(3,2)).expect(sequenceSafe)
    .then(capture(3,2)).expect(sequenceSafe)
    .then(prove(3,2)).expect(sequenceSafe)
    .then(deliver(3,2)).expect(sequenceSafe)
    .then(commit(3)).expect(sequenceSafe)
    .then(finalize(3,3)).expect(sequenceSafe)
    .then(capture(3,3)).expect(sequenceSafe)
    .then(prove(3,3)).expect(sequenceSafe)
    .then(deliver(3,3)).expect(sequenceSafe)
    .then(learn(3,2,1)).expect(sequenceSafe)
    .then(applyB(3)).expect(sequenceSafe)
    .then(finalize(3,5)).expect(sequenceSafe)
    .then(capture(3,5)).expect(sequenceSafe)
    .then(prove(3,5)).expect(sequenceSafe)
    .then(deliver(3,5)).expect(sequenceSafe)
    .then(observe(3,0)).expect(sequenceSafe)
    .then(finalize(3,6)).expect(sequenceSafe)
    .then(capture(3,6)).expect(sequenceSafe)
    .then(prove(3,6)).expect(sequenceSafe)
    .then(deliver(3,6)).expect(sequenceSafe)
    .then(observe(3,1)).expect(sequenceSafe)
    .then(reconcile(3)).expect(sequenceSafe).expect(committedTrade(1) and releasedTrade(2) and committedTrade(3))
  run parallelHeld = sequential
    .then(sign(4,0)).expect(sequenceSafe)
    .then(sign(4,1)).expect(sequenceSafe)
    .then(openA(4)).expect(sequenceSafe)
    .then(prepareB(4)).expect(sequenceSafe)
    .then(sign(5,0)).expect(sequenceSafe)
    .then(sign(5,1)).expect(sequenceSafe)
    .then(openA(5)).expect(sequenceSafe)
    .then(prepareB(5)).expect(sequenceSafe)
    .then(sign(6,0)).expect(sequenceSafe)
    .then(sign(6,1)).expect(sequenceSafe)
    .then(openA(6)).expect(sequenceSafe)
    .then(prepareB(6)).expect(sequenceSafe).expect(PARALLEL.forall(t=>pending(t)) and reservedA(s)==6 and reservedB(s)==9 and durablePrefix)
  run ready = parallelHeld
    .then(finalize(4,2)).expect(sequenceSafe)
    .then(capture(4,2)).expect(sequenceSafe)
    .then(prove(4,2)).expect(sequenceSafe)
    .then(deliver(4,2)).expect(sequenceSafe)
    .then(finalize(5,2)).expect(sequenceSafe)
    .then(capture(5,2)).expect(sequenceSafe)
    .then(prove(5,2)).expect(sequenceSafe)
    .then(deliver(5,2)).expect(sequenceSafe)
    .then(finalize(6,2)).expect(sequenceSafe)
    .then(capture(6,2)).expect(sequenceSafe)
    .then(prove(6,2)).expect(sequenceSafe)
    .then(deliver(6,2)).expect(sequenceSafe)
  run waitingCash = ready
    .then(commit(4)).expect(sequenceSafe)
    .then(finalize(4,3)).expect(sequenceSafe)
    .then(capture(4,3)).expect(sequenceSafe)
    .then(prove(4,3)).expect(sequenceSafe)
    .then(deliver(4,3)).expect(sequenceSafe)
    .then(learn(4,2,1)).expect(sequenceSafe)
  run signedSeven = parallelHeld
    .then(sign(7,0)).expect(sequenceSafe)
    .then(sign(7,1)).expect(sequenceSafe)
  run lateOutcome = ready
    .then(commit(4)).expect(sequenceSafe)
    .then(finalize(4,3)).expect(sequenceSafe)
    .then(capture(4,3)).expect(sequenceSafe)
    .then(prove(4,3)).expect(sequenceSafe)
    .then(lose(4,3)).expect(sequenceSafe)
  run SequentialCommitAbortCommitTest = sequential.expect(s.height==3 and s.ownerA==6 and s.ownerB==9 and durablePrefix)
  run ParallelReservationsTest = parallelHeld
  run ContendedATest = signedSeven.then(openA(7).fail())
  run ContendedBTest = signedSeven.then(prepareB(7).fail())
  run ReservedSecuritiesCannotBeSpentTest = parallelHeld.then(spend(0).fail())
  run ReservedCashCannotBeSpentTest = parallelHeld.then(spend(1).fail())
  run OldPreparationCannotCommitNewTradeTest = parallelHeld.expect(s.received.contains(fact(3,2))).then(commit(4).fail())
  run OldOutcomeCannotApplyNewTradeTest = parallelHeld.expect(s.received.contains(fact(3,3))).then(learn(4,2,1).fail())
  run OlderDeadlineReachedWhileLaterTradeCanCommitTest = ready.expect(s.height==desc(2).deadline and s.height<desc(4).deadline).then(abort(4).fail())
  run DuplicateCashCannotApplyAgainTest = waitingCash
    .then(applyB(4)).expect(sequenceSafe)
    .then(deliver(4,3)).expect(sequenceSafe)
    .then(learn(4,2,1)).expect(sequenceSafe).then(applyB(4).fail())
  run LostOutcomeCannotBeLearnedTest = lateOutcome.expect(not(s.network.contains(fact(4,3))) and s.proofs.contains(fact(4,3))).then(learn(4,2,1).fail())
  run RecoveryAfterDropPruneAndRestartTest = lateOutcome
    .then(prune(4,3)).expect(sequenceSafe)
    .then(crash(1)).expect(sequenceSafe)
    .then(crash(3)).expect(sequenceSafe)
    .then(crash(4)).expect(sequenceSafe)
    .then(recover(4)).expect(sequenceSafe)
    .then(resend(4,3)).expect(sequenceSafe)
    .then(deliver(4,3)).expect(sequenceSafe)
    .then(recover(1)).expect(sequenceSafe)
    .then(learn(4,2,1)).expect(sequenceSafe)
    .then(applyB(4)).expect(sequenceSafe)
    .then(recover(3)).expect(sequenceSafe)
    .then(finalize(4,5)).expect(sequenceSafe)
    .then(capture(4,5)).expect(sequenceSafe)
    .then(prove(4,5)).expect(sequenceSafe)
    .then(deliver(4,5)).expect(sequenceSafe)
    .then(observe(4,0)).expect(sequenceSafe)
    .then(finalize(4,6)).expect(sequenceSafe)
    .then(capture(4,6)).expect(sequenceSafe)
    .then(prove(4,6)).expect(sequenceSafe)
    .then(deliver(4,6)).expect(sequenceSafe)
    .then(observe(4,1)).expect(sequenceSafe)
    .then(reconcile(4)).expect(sequenceSafe)
    .then(finalize(1,5)).expect(sequenceSafe)
    .then(capture(1,5)).expect(sequenceSafe)
    .then(prove(1,5)).expect(sequenceSafe)
    .then(deliver(1,5)).expect(sequenceSafe)
    .then(observe(1,0)).expect(sequenceSafe)
    .then(finalize(1,6)).expect(sequenceSafe)
    .then(capture(1,6)).expect(sequenceSafe)
    .then(prove(1,6)).expect(sequenceSafe)
    .then(deliver(1,6)).expect(sequenceSafe)
    .then(observe(1,1)).expect(sequenceSafe)
    .then(reconcile(1)).expect(sequenceSafe).expect(committedTrade(4) and pending(5) and pending(6) and s.financialRecords.size()==4 and durablePrefix)
  run OldApplicationCannotBookAnotherTradeTest = waitingCash.expect(s.received.contains(fact(1,6))).then(observe(4,1).fail())
  run PruneBeforeWitnessTest = parallelHeld.then(finalize(4,2)).expect(s.finalized.contains(fact(4,2))).then(prune(4,2).fail())
  run UnadmittedProofCannotDecideTest = parallelHeld
    .then(finalize(4,2)).expect(sequenceSafe)
    .then(capture(4,2)).expect(sequenceSafe)
    .then(proveUnadmitted(4,2)).expect(sequenceSafe)
    .then(deliverUnadmitted(4,2)).expect(sequenceSafe).expect(s.proofs.contains({...fact(4,2),program:0}) and not(has(s,4,2))).then(commit(4).fail())
  run UnadmittedProofCannotApplyTest = ready
    .then(commit(4)).expect(sequenceSafe)
    .then(finalize(4,3)).expect(sequenceSafe)
    .then(capture(4,3)).expect(sequenceSafe)
    .then(proveUnadmitted(4,3)).expect(sequenceSafe)
    .then(deliverUnadmitted(4,3)).expect(sequenceSafe).expect(s.proofs.contains({...fact(4,3),program:0}) and not(has(s,4,3))).then(learn(4,2,1).fail())
  run AFrozenCannotCommitTest = ready
    .then(freeze(0)).expect(sequenceSafe).expect(pending(4)).then(commit(4).fail())
  run BFrozenCannotApplyTest = waitingCash
    .then(freeze(1)).expect(sequenceSafe).expect(s.trades.get(4).holdB==1).then(applyB(4).fail())
  run UnfreezeAndExitDoesNotRevokePendingTest = waitingCash
    .then(freeze(1)).expect(sequenceSafe)
    .then(rotate).expect(sequenceSafe)
    .then(exitMember).expect(sequenceSafe)
    .then(unfreeze(1)).expect(sequenceSafe)
    .then(applyB(4)).expect(sequenceSafe)
    .then(finalize(4,5)).expect(sequenceSafe)
    .then(capture(4,5)).expect(sequenceSafe)
    .then(prove(4,5)).expect(sequenceSafe)
    .then(deliver(4,5)).expect(sequenceSafe)
    .then(observe(4,0)).expect(sequenceSafe)
    .then(finalize(4,6)).expect(sequenceSafe)
    .then(capture(4,6)).expect(sequenceSafe)
    .then(prove(4,6)).expect(sequenceSafe)
    .then(deliver(4,6)).expect(sequenceSafe)
    .then(observe(4,1)).expect(sequenceSafe)
    .then(reconcile(4)).expect(sequenceSafe)
    .then(receiveNote(4)).expect(sequenceSafe)
    .then(compromiseTransport).expect(sequenceSafe)
    .then(idle).expect(sequenceSafe).expect(committedTrade(4) and s.note.contains(4) and s.transportCompromised and S16 and not(s.admitted) and durablePrefix)
  run LateAbortStillReleasesInParallelTest = ready
    .then(commit(4)).expect(sequenceSafe)
    .then(finalize(4,3)).expect(sequenceSafe)
    .then(capture(4,3)).expect(sequenceSafe)
    .then(prove(4,3)).expect(sequenceSafe)
    .then(deliver(4,3)).expect(sequenceSafe)
    .then(learn(4,2,1)).expect(sequenceSafe)
    .then(applyB(4)).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(abort(5)).expect(sequenceSafe)
    .then(finalize(5,4)).expect(sequenceSafe)
    .then(capture(5,4)).expect(sequenceSafe)
    .then(prove(5,4)).expect(sequenceSafe)
    .then(deliver(5,4)).expect(sequenceSafe)
    .then(learn(5,3,1)).expect(sequenceSafe)
    .then(refund(5,0)).expect(sequenceSafe)
    .then(refund(5,1)).expect(sequenceSafe)
    .then(captureAbortRecord(5,0)).expect(sequenceSafe)
    .then(captureAbortRecord(5,1)).expect(sequenceSafe)
    .then(recordAbort(5)).expect(sequenceSafe)
    .then(commit(6)).expect(sequenceSafe)
    .then(finalize(6,3)).expect(sequenceSafe)
    .then(capture(6,3)).expect(sequenceSafe)
    .then(prove(6,3)).expect(sequenceSafe)
    .then(deliver(6,3)).expect(sequenceSafe)
    .then(learn(6,2,1)).expect(sequenceSafe)
    .then(applyB(6)).expect(sequenceSafe)
    .then(finalize(6,5)).expect(sequenceSafe)
    .then(capture(6,5)).expect(sequenceSafe)
    .then(prove(6,5)).expect(sequenceSafe)
    .then(deliver(6,5)).expect(sequenceSafe)
    .then(observe(6,0)).expect(sequenceSafe)
    .then(finalize(6,6)).expect(sequenceSafe)
    .then(capture(6,6)).expect(sequenceSafe)
    .then(prove(6,6)).expect(sequenceSafe)
    .then(deliver(6,6)).expect(sequenceSafe)
    .then(observe(6,1)).expect(sequenceSafe)
    .then(reconcile(6)).expect(sequenceSafe)
    .then(finalize(4,5)).expect(sequenceSafe)
    .then(capture(4,5)).expect(sequenceSafe)
    .then(prove(4,5)).expect(sequenceSafe)
    .then(deliver(4,5)).expect(sequenceSafe)
    .then(observe(4,0)).expect(sequenceSafe)
    .then(finalize(4,6)).expect(sequenceSafe)
    .then(capture(4,6)).expect(sequenceSafe)
    .then(prove(4,6)).expect(sequenceSafe)
    .then(deliver(4,6)).expect(sequenceSafe)
    .then(observe(4,1)).expect(sequenceSafe)
    .then(reconcile(4)).expect(sequenceSafe).expect(committedTrade(4) and releasedTrade(5) and committedTrade(6) and durablePrefix and s.financialRecords.size()==6)
  run ContenderTombstoneHasNoRefundsTest = signedSeven
    .then(finalize(4,2)).expect(sequenceSafe)
    .then(capture(4,2)).expect(sequenceSafe)
    .then(prove(4,2)).expect(sequenceSafe)
    .then(deliver(4,2)).expect(sequenceSafe)
    .then(commit(4)).expect(sequenceSafe)
    .then(finalize(4,3)).expect(sequenceSafe)
    .then(capture(4,3)).expect(sequenceSafe)
    .then(prove(4,3)).expect(sequenceSafe)
    .then(deliver(4,3)).expect(sequenceSafe)
    .then(learn(4,2,1)).expect(sequenceSafe)
    .then(applyB(4)).expect(sequenceSafe)
    .then(finalize(4,5)).expect(sequenceSafe)
    .then(capture(4,5)).expect(sequenceSafe)
    .then(prove(4,5)).expect(sequenceSafe)
    .then(deliver(4,5)).expect(sequenceSafe)
    .then(observe(4,0)).expect(sequenceSafe)
    .then(finalize(4,6)).expect(sequenceSafe)
    .then(capture(4,6)).expect(sequenceSafe)
    .then(prove(4,6)).expect(sequenceSafe)
    .then(deliver(4,6)).expect(sequenceSafe)
    .then(observe(4,1)).expect(sequenceSafe)
    .then(reconcile(4)).expect(sequenceSafe)
    .then(finalize(5,2)).expect(sequenceSafe)
    .then(capture(5,2)).expect(sequenceSafe)
    .then(prove(5,2)).expect(sequenceSafe)
    .then(deliver(5,2)).expect(sequenceSafe)
    .then(commit(5)).expect(sequenceSafe)
    .then(finalize(5,3)).expect(sequenceSafe)
    .then(capture(5,3)).expect(sequenceSafe)
    .then(prove(5,3)).expect(sequenceSafe)
    .then(deliver(5,3)).expect(sequenceSafe)
    .then(learn(5,2,1)).expect(sequenceSafe)
    .then(applyB(5)).expect(sequenceSafe)
    .then(finalize(5,5)).expect(sequenceSafe)
    .then(capture(5,5)).expect(sequenceSafe)
    .then(prove(5,5)).expect(sequenceSafe)
    .then(deliver(5,5)).expect(sequenceSafe)
    .then(observe(5,0)).expect(sequenceSafe)
    .then(finalize(5,6)).expect(sequenceSafe)
    .then(capture(5,6)).expect(sequenceSafe)
    .then(prove(5,6)).expect(sequenceSafe)
    .then(deliver(5,6)).expect(sequenceSafe)
    .then(observe(5,1)).expect(sequenceSafe)
    .then(reconcile(5)).expect(sequenceSafe)
    .then(finalize(6,2)).expect(sequenceSafe)
    .then(capture(6,2)).expect(sequenceSafe)
    .then(prove(6,2)).expect(sequenceSafe)
    .then(deliver(6,2)).expect(sequenceSafe)
    .then(commit(6)).expect(sequenceSafe)
    .then(finalize(6,3)).expect(sequenceSafe)
    .then(capture(6,3)).expect(sequenceSafe)
    .then(prove(6,3)).expect(sequenceSafe)
    .then(deliver(6,3)).expect(sequenceSafe)
    .then(learn(6,2,1)).expect(sequenceSafe)
    .then(applyB(6)).expect(sequenceSafe)
    .then(finalize(6,5)).expect(sequenceSafe)
    .then(capture(6,5)).expect(sequenceSafe)
    .then(prove(6,5)).expect(sequenceSafe)
    .then(deliver(6,5)).expect(sequenceSafe)
    .then(observe(6,0)).expect(sequenceSafe)
    .then(finalize(6,6)).expect(sequenceSafe)
    .then(capture(6,6)).expect(sequenceSafe)
    .then(prove(6,6)).expect(sequenceSafe)
    .then(deliver(6,6)).expect(sequenceSafe)
    .then(observe(6,1)).expect(sequenceSafe)
    .then(reconcile(6)).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(tick).expect(sequenceSafe)
    .then(abort(7)).expect(sequenceSafe)
    .then(finalize(7,4)).expect(sequenceSafe)
    .then(capture(7,4)).expect(sequenceSafe)
    .then(prove(7,4)).expect(sequenceSafe)
    .then(deliver(7,4)).expect(sequenceSafe)
    .then(learn(7,3,1)).expect(sequenceSafe)
    .then(captureAbortRecord(7,0)).expect(sequenceSafe)
    .then(captureAbortRecord(7,1)).expect(sequenceSafe)
    .then(recordAbort(7)).expect(sequenceSafe).expect(s.financialRecords.size()==7 and evidenceBackedBooking(s,desc(7)) and s.trades.get(7).refundsA==0 and s.trades.get(7).refundsB==0)
  run CashCannotSpendWhileBOfflineTest = init.expect(sequenceSafe)
    .then(crash(1)).expect(sequenceSafe).expect(s.ownerB==15 and not(s.up.contains(1))).then(spend(1).fail())
  run SecuritiesCannotSpendWhileAOfflineTest = init.expect(sequenceSafe)
    .then(crash(0)).expect(sequenceSafe).expect(s.ownerA==10 and not(s.up.contains(0))).then(spend(0).fail())
  run IndependentSpendingRecoversTest = init.expect(sequenceSafe)
    .then(crash(0)).expect(sequenceSafe)
    .then(spend(1)).expect(sequenceSafe)
    .then(recover(0)).expect(sequenceSafe)
    .then(spend(0)).expect(sequenceSafe).expect(s.ownerA==9 and s.ownerB==14 and s.spentA==1 and s.spentB==1)
  run RevokedLegCannotPrepareTest = init.expect(sequenceSafe)
    .then(sign(1,0)).expect(sequenceSafe)
    .then(sign(1,1)).expect(sequenceSafe)
    .then(revokeLeg(1,1)).expect(sequenceSafe)
    .then(openA(1)).expect(sequenceSafe).expect(s.trades.get(1).holdA==1 and not(s.eligible.contains((1,1)))).then(prepareB(1).fail())
  run RevokeBothCannotOpenTest = init.expect(sequenceSafe)
    .then(sign(1,0)).expect(sequenceSafe)
    .then(sign(1,1)).expect(sequenceSafe)
    .then(revoke(1)).expect(sequenceSafe).expect(not(s.eligible.contains((1,0))) and not(s.eligible.contains((1,1)))).then(openA(1).fail())
  run ReplayAlteredCashRequestTest = init.expect(sequenceSafe)
    .then(sign(1,0)).expect(sequenceSafe)
    .then(sign(1,1)).expect(sequenceSafe).then(requestCash(1,{...desc(1),nonce:99}).fail())
  run ExactRequestWrappersTest = init.expect(sequenceSafe)
    .then(sign(1,0)).expect(sequenceSafe)
    .then(sign(1,1)).expect(sequenceSafe)
    .then(requestOpen(1,desc(1))).expect(sequenceSafe)
    .then(requestCash(1,desc(1))).expect(sequenceSafe).expect(pending(1))
  run FinalizeDownActor0Test = waitingCash
    .then(crash(0)).expect(sequenceSafe).then(finalize(4,5).fail())
  run FinalizeRecoveredActor0Test = waitingCash
    .then(crash(0)).expect(sequenceSafe)
    .then(recover(0)).expect(sequenceSafe)
    .then(finalize(4,5)).expect(sequenceSafe)
  run FinalizeDownActor1Test = waitingCash
    .then(crash(1)).expect(sequenceSafe).then(finalize(5,2).fail())
  run FinalizeRecoveredActor1Test = waitingCash
    .then(crash(1)).expect(sequenceSafe)
    .then(recover(1)).expect(sequenceSafe)
    .then(finalize(5,2)).expect(sequenceSafe)
  run SubmitDownActor2Test = waitingCash
    .then(crash(2)).expect(sequenceSafe).then(applyB(4).fail())
  run SubmitRecoveredActor2Test = waitingCash
    .then(crash(2)).expect(sequenceSafe)
    .then(recover(2)).expect(sequenceSafe)
    .then(applyB(4)).expect(sequenceSafe)
  run ProveDownActor3Test = waitingCash
    .then(crash(3)).expect(sequenceSafe).then(prove(4,3).fail())
  run ProveRecoveredActor3Test = waitingCash
    .then(crash(3)).expect(sequenceSafe)
