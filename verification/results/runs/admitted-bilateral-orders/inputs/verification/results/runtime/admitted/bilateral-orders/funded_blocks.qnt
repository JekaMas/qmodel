    .then(localStep(executeTx(1,3)))
    .then(localStep(executeTx(0,3)))
    .then(localStep(executeTx(1,2)))
    .then(localStep(sealBlock(0)))
    .then(localStep(sealBlock(1))).expect(blockSound and lane(0).applied==Set(1,2) and lane(1).applied==Set(1,3))
    .then(publish(1,2))
    .then(localStep(nextA))
    .then(localStep(openBlock(0,Settle,Set(1))))
    .then(localStep(executeTx(0,1)))
    .then(localStep(sealBlock(0)))
    .then(publish(1,3))
    .then(localStep(takeOutcome(1)))
    .then(localStep(nextB))
    .then(localStep(openBlock(1,Settle,Set(1))))
