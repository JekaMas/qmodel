module funded_blocks {
  import dvp_blocks(COUNT=3,FAULT=0).* from "./dvp_blocks"
  import guarantee_oracles.* from "./guarantee_oracles"
  var pc:int
  action blockInit=all {start,pc'=0}
  action blockWork(leg:int,kind:int):bool=any {
    openBlock(leg,kind,Ids),sealBlock(leg),
    nondet t=Ids.oneOf(); executeTx(leg,t)
  }
  pure val signedPC=6
  pure val heldPC=8
  pure val donePC=8
  action work=any {
    all {pc==0,authorize(1,0),pc'=1},
    all {pc==1,authorize(1,1),pc'=2},
    all {pc==2,authorize(2,0),pc'=3},
    all {pc==3,authorize(2,1),pc'=4},
    all {pc==4,authorize(3,0),pc'=5},
    all {pc==5,authorize(3,1),pc'=6},
    all {pc==6, pc'=pc, nondet leg=Set(0,1).oneOf(); blockWork(leg,Reserve)},
    all {pc==6, Set(0,1).forall(leg=>processed(leg,Reserve)), waitBlock,pc'=8},
  }

  // There is no nonterminal stutter. The fixed program and each open block's
  // finite remaining work give a finite ascending rank before this endpoint.
  action blockStep=any {work,all {pc==donePC,pc'=pc,waitBlock}}
  val economicSound=coreSound and
    Ids.forall(t=>tradeGuarantees(sourceState,tradeTerms(t)))
  val fullyBooked=Ids.forall(t=>{
    val row=sourceState.trades.get(t)
    and {row.decision==2,row.effectsA==1,row.effectsB==1,
      evidenceBackedBooking(sourceState,tradeTerms(t))}
  })
  val sound=economicSound and blockSound and (pc==donePC implies (lane(0).applied.size()==2 and lane(1).applied.size()==2 and Ids.forall(t=>and {sourceState.trades.get(t).preparedA==lane(0).applied.contains(t),sourceState.trades.get(t).preparedB==lane(1).applied.contains(t)})))
  temporal includedProgress=work.weakFair((pc,blocks)).implies(eventually(pc==donePC))

  action localStep(op:bool):bool=all {op,pc'=pc}
  action publish(t:int,p:int):bool=localStep(finalizeSealed(t,p))
    .then(localStep(proofJob(t,p,1))).then(localStep(proofJob(t,p,2))).then(localStep(proofJob(t,p,3)))
  run Bilateral123_123Test=blockInit
    .then(signedPC.reps(_=>blockStep))
    .then(localStep(openBlock(0,Reserve,Ids)))
    .then(localStep(openBlock(1,Reserve,Ids)))
    .then(localStep(executeTx(0,1)))
    .then(localStep(executeTx(1,1)))
    .then(localStep(executeTx(0,2)))
    .then(localStep(executeTx(1,2)))
    .then(localStep(executeTx(0,3)))
    .then(localStep(executeTx(1,3)))
    .then(localStep(sealBlock(0)))
    .then(localStep(sealBlock(1))).expect(blockSound and lane(0).applied==Set(1,2) and lane(1).applied==Set(1,2))
    .then(publish(1,2))
    .then(publish(2,2))
    .then(localStep(nextA))
    .then(localStep(openBlock(0,Settle,Set(1,2))))
    .then(localStep(executeTx(0,1)))
    .then(localStep(executeTx(0,2)))
    .then(localStep(sealBlock(0)))
    .then(publish(1,3))
    .then(localStep(takeOutcome(1)))
    .then(publish(2,3))
    .then(localStep(takeOutcome(2)))
    .then(localStep(nextB))
    .then(localStep(openBlock(1,Settle,Set(1,2))))
    .then(localStep(executeTx(1,1)))
    .then(localStep(executeTx(1,2)))
    .then(localStep(sealBlock(1)))
    .then(publish(1,5))
    .then(localStep(observeEffect(1,0)))
    .then(publish(1,6))
    .then(localStep(observeEffect(1,1)))
    .then(localStep(bookTrade(1)))
    .then(publish(2,5))
    .then(localStep(observeEffect(2,0)))
    .then(publish(2,6))
    .then(localStep(observeEffect(2,1)))
    .then(localStep(bookTrade(2)))
    .then(localStep(nextA))
    .then(localStep(expire(3)))
    .then(publish(3,4))
    .then(localStep(takeAbort(3)))
    .then(localStep(readDisposition(3,0)))
    .then(localStep(readDisposition(3,1)))
    .then(localStep(bookAbort(3)))
    .expect(economicSound and blockSound and sourceState.financialRecords.size()==3 and Ids.forall(t=>evidenceBackedBooking(sourceState,tradeTerms(t))) and Ids.filter(t=>sourceState.trades.get(t).decision==2)==Set(1,2) and Ids.filter(t=>sourceState.trades.get(t).decision==3)==Set(3) and free(sourceState,0)==0 and free(sourceState,1)==0)
  run Bilateral123_132Test=blockInit
    .then(signedPC.reps(_=>blockStep))
    .then(localStep(openBlock(0,Reserve,Ids)))
    .then(localStep(openBlock(1,Reserve,Ids)))
    .then(localStep(executeTx(0,1)))
    .then(localStep(executeTx(1,1)))
