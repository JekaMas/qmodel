    .then(localStep(bookAbort(3)))
    .expect(economicSound and blockSound and sourceState.financialRecords.size()==3 and Ids.forall(t=>evidenceBackedBooking(sourceState,tradeTerms(t))) and Ids.filter(t=>sourceState.trades.get(t).decision==2)==Set(1,2) and Ids.filter(t=>sourceState.trades.get(t).decision==3)==Set(3) and free(sourceState,0)==0 and free(sourceState,1)==0)
