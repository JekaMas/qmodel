    .then(localStep(sealBlock(1)))
    .then(publish(1,5))
    .then(localStep(observeEffect(1,0)))
    .then(publish(1,6))
    .then(localStep(observeEffect(1,1)))
    .then(localStep(bookTrade(1)))
    .then(localStep(nextA))
    .then(localStep(expire(2)))
    .then(publish(2,4))
    .then(localStep(takeAbort(2)))
    .then(localStep(releaseHold(2,0)))
    .then(localStep(readDisposition(2,0)))
    .then(localStep(readDisposition(2,1)))
    .then(localStep(bookAbort(2)))
    .then(localStep(expire(3)))
